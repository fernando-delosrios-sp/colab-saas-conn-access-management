{
    "name": "access-management",
    "version": "0.2.1",
    "main": "dist/index.js",
    "scripts": {
        "clean": "shx rm -rf ./dist",
        "prebuild": "npm run clean",
        "build": "npx ncc build ./src/index.ts -o ./dist -m -C",
        "dev": "cross-env NODE_OPTIONS=--enable-source-maps spcx run dist/index.js",
        "debug": "spcx run dist/index.js",
        "prettier": "npx prettier --write .",
        "test": "tsx --test src/utils/index.test.ts",
        "prepack-zip": "npm ci && npm run build",
        "pack-zip": "spcx package"
    },
    "private": true,
    "dependencies": {
        "@sailpoint/connector-sdk": "1.2.4",
        "sailpoint-api-client": "1.8.69",
        "axios-retry": "^4.5.0",
        "form-data": "^4.0.2",
        "velocityjs": "^2.1.5"
    },
    "devDependencies": {
        "@types/node": "^26.0.1",
        "@vercel/ncc": "^0.34.0",
        "cross-env": "7.0.3",
        "prettier": "^2.3.2",
        "shx": "^0.3.3",
        "tsx": "^4.22.4",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.2.0",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "@types/jest": "^30.0.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "clearMocks": true,
        "collectCoverage": true,
        "coverageThreshold": {
            "global": {
                "statements": 60,
                "branches": 50,
                "functions": 40,
                "lines": 60
            }
        }
    },
    "prettier": {
        "printWidth": 120,
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "esbuild@0.28.1": true,
        "unrs-resolver@1.11.1": true
    }
}